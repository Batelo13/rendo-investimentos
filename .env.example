# Variaveis utilizadas pelo Docker Compose
POSTGRES_DB=rendodb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432
APP_PORT=8080

# APIs externas opcionais
BRAPI_API_TOKEN=
TWELVEDATA_API_KEY=demo

# Login social opcional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Envio de email (codigo de verificacao de cadastro). Com MAIL_ENABLED=false
# o codigo continua sendo gerado normalmente, so o envio real e pulado.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@rendo.app
