# Variaveis utilizadas pelo Docker Compose
POSTGRES_DB=rendodb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432
APP_PORT=8080

# Cookie de sessao com atributo Secure: ligue (true) somente quando a aplicacao
# estiver atras de HTTPS (producao). Em HTTP local o navegador descartaria o cookie.
SESSION_COOKIE_SECURE=false

# Chave secreta do HMAC do CPF (o CPF nunca e gravado em claro). Obrigatoria
# fora do profile dev; minimo 32 caracteres. Gere uma vez e NAO troque depois:
# trocar a chave impede detectar CPF duplicado nos cadastros antigos.
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   Linux/macOS: openssl rand -base64 48
CPF_HASH_KEY=

# Emails (separados por virgula) que recebem papel ADMIN no cadastro e ao
# iniciar a aplicacao. Mantenha so no .env -- nunca no codigo.
ADMIN_EMAILS=

# APIs externas opcionais
BRAPI_API_TOKEN=
TWELVEDATA_API_KEY=demo

# Login social opcional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Envio de email (codigo de verificacao de cadastro). Com MAIL_ENABLED=false
# o codigo continua sendo gerado normalmente, so o envio real e pulado.
MAIL_ENABLED=false
# Com MAIL_ENABLED=false, MAIL_LOG_CODE=true escreve o codigo de verificacao no
# log (util so em desenvolvimento local). Padrao: true no profile dev, false no
# docker. Nunca ligue em producao: quem le o log validaria contas alheias.
MAIL_LOG_CODE=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@rendo.app
