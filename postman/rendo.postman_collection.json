    {
      "name": "09 - API com JWT (Aulas 13 e 14)",
      "description": "Login por token: sem cookie e sem CSRF. O token vai no cabecalho Authorization: Bearer. Rode depois da pasta 01 (conta verificada). Para testar 403, use uma conta USER; para 200 nas rotas ADMIN, um email listado em ADMIN_EMAILS.",
      "item": [
        {
          "name": "POST /api/auth/login (emite token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{usuarioEmail}}\",\n  \"senha\": \"{{usuarioSenha}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 e token Bearer\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.tipo).to.eql(\"Bearer\");",
                  "    pm.expect(r.expiresIn).to.be.above(0);",
                  "    pm.collectionVariables.set(\"jwt\", r.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login (senha errada -> 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
